# Cerbo / Venus local MQTT
VENUS_MQTT_URL=mqtt://192.168.1.50:1883
VENUS_PORTAL_ID=
VENUS_MQTT_USER=
VENUS_MQTT_PASSWORD=

# AUX / digital input mapping (§14a limited)
VENUS_AUX_LIMIT_SERVICE=digitalinput
VENUS_AUX_LIMIT_INSTANCE=1
# optional second input for full off:
# VENUS_AUX_OFF_SERVICE=digitalinput
# VENUS_AUX_OFF_INSTANCE=2
VENUS_LIMIT_KW=4.2

COLLECTOR_INTERVAL_MS=5000
PORT=8787
