# Cerbo / Venus local MQTT
VENUS_MQTT_URL=mqtt://192.168.1.50:1883
VENUS_PORTAL_ID=
VENUS_MQTT_USER=
VENUS_MQTT_PASSWORD=

# EnWG §14a – AUX / digital input mapping (limited offtake)
VENUS_AUX_LIMIT_SERVICE=digitalinput
VENUS_AUX_LIMIT_INSTANCE=1
# VENUS_AUX_OFF_SERVICE=digitalinput
# VENUS_AUX_OFF_INSTANCE=2
VENUS_LIMIT_KW=4.2

# EEG §9 – feed-in curtailment inputs (optional)
# VENUS_FEEDIN_CURTAIL_SERVICE=digitalinput
# VENUS_FEEDIN_CURTAIL_INSTANCE=3
# VENUS_FEEDIN_ZERO_SERVICE=digitalinput
# VENUS_FEEDIN_ZERO_INSTANCE=4
VENUS_FEEDIN_CURTAIL_PERCENT=0.6
VENUS_PV_RATED_KW=10

# MultiPlus writes (charger limit / feed-in) – enable only after path verification
# VENUS_ENABLE_MULTI_WRITES=true

COLLECTOR_INTERVAL_MS=5000
PORT=8787
